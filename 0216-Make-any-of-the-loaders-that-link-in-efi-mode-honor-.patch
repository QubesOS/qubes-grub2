new file mode 100644
index 000000000000..e69de29bb2d1
diff --git a/include/grub/mips/linux.h b/include/grub/mips/linux.h
new file mode 100644
index 000000000000..e69de29bb2d1
diff --git a/include/grub/powerpc/linux.h b/include/grub/powerpc/linux.h
new file mode 100644
index 000000000000..e69de29bb2d1
